# ─────────────────────────────────────────────────────────────
# Playona FE — PRODUCTION
# `npm run build` 또는 Vercel 빌드 시 사용됩니다.
# Vercel 환경변수에 같은 키를 등록하면 그 값이 우선합니다.
# ─────────────────────────────────────────────────────────────

# 비워두면 FE가 상대 경로(/api/...)로 호출하고, Vercel 의 rewrites(vercel.json)
# 가 백엔드로 포워딩합니다. (mixed-content / CORS 우회)
# 백엔드를 HTTPS 도메인으로 띄우면 그 주소로 채우고 rewrites 를 제거하세요.
VITE_API_BASE_URL=

# 공유링크 표시용 base. 비우면 window.location.origin.
VITE_SHARE_BASE_URL=

# Vercel 미들웨어(middleware.ts)가 OG 태그 주입용으로 호출하는 백엔드 주소.
# 서버 사이드 전용. Vercel 프로젝트 환경변수에도 동일 키를 등록해야 함.
BACKEND_ORIGIN=http://43.201.139.24:8080

VITE_USE_MOCK_AUTH=

VITE_KAKAO_LOGIN_URL=
VITE_GOOGLE_LOGIN_URL=
VITE_APPLE_LOGIN_URL=
