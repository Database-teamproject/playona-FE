# ─────────────────────────────────────────────────────────────
# Playona FE — DEVELOPMENT
# 로컬 개발용 환경변수. `npm run dev` 시 사용됩니다.
# (프로덕션 빌드는 .env.production 을 사용)
# ─────────────────────────────────────────────────────────────

# 로컬 개발에서는 비워둡니다.
# Vite proxy(/api, /oauth2, /login/oauth2)가 자동으로 백엔드로 전달하여
# 브라우저 입장에서는 same-origin이 되어 CORS 차단을 우회합니다.
VITE_API_BASE_URL=

# Vite proxy 가 요청을 전달할 백엔드 주소(개발자만 사용, FE 코드는 안 읽음).
# 비워두면 vite.config.ts 의 기본값(http://43.201.139.24:8080) 사용.
VITE_API_PROXY_TARGET=http://43.201.139.24:8080

# Vercel 미들웨어(middleware.ts)가 OG 태그 주입용으로 호출하는 백엔드 주소.
# 서버 사이드 전용(VITE_ 접두사 없음 → 클라이언트에 노출 안 됨).
BACKEND_ORIGIN=http://43.201.139.24:8080

# 공유링크 표시용 base. 비우면 window.location.origin.
VITE_SHARE_BASE_URL=

# Mock 인증 모드. 평소엔 비워두세요. "true" 면 가짜 세션.
VITE_USE_MOCK_AUTH=

# 소셜 로그인 URL 직접 지정(보통 비움 → 자동으로 ${VITE_API_BASE_URL}/oauth2/authorization/<provider>).
VITE_KAKAO_LOGIN_URL=
VITE_GOOGLE_LOGIN_URL=
VITE_APPLE_LOGIN_URL=
